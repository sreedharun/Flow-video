# Google Gemini API Key for script writing
GEMINI_API_KEY=your_gemini_api_key_here

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Video Generation Provider: 'mock' (for free testing/dev) or 'flow' (Playwright Google Flow automation)
VIDEO_PROVIDER=mock

# Playwright Browser Settings
BROWSER_HEADLESS=false
FLOW_NAV_TIMEOUT_MS=60000
